PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# Embedded HTTPS (optional). Both TLS_CERT_FILE and TLS_KEY_FILE must be set to enable.
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem
# HTTPS_ONLY=true
# When HTTPS_ONLY=false, HTTP listens on PORT and HTTPS on HTTPS_PORT (default 3443).
# HTTPS_PORT=3443

# Login RSA: private key PEM in env (\\n for newlines) OR file path OR auto-generate under data/.
# LOGIN_PASSWORD_RSA_PRIVATE_KEY=
# LOGIN_PASSWORD_RSA_KEY_FILE=data/login_password_rsa_private.pem

# Redis: default redis://127.0.0.1:6379/0 when REDIS_CONN_STRING is unset. Set to disable Redis-backed features.
# REDIS_DISABLED=true

# Force 2FA for all users (web session + API key relay blocked until TOTP enabled).
# FORCE_2FA_FOR_ALL_USERS=false

# When Turnstile is off, require click captcha on login (see /login/captcha).
# LOGIN_MATH_CAPTCHA_ENABLED=false

# Login brute-force limits (see common/login_brute_protect.go). Trust XFF only behind your own reverse proxy.
# LOGIN_BRUTE_IP_FAIL_MAX=20
# LOGIN_BRUTE_PAIR_FAIL_MAX=10
# LOGIN_BRUTE_FAIL_WINDOW_SEC=900
# LOGIN_BRUTE_LOCK_DURATION_SEC=900
# LOGIN_BRUTE_TRUST_X_FORWARDED_FOR=false

# Global access list: which routes the gate applies to (comma-separated: relay,console,api).
# GLOBAL_ACCESS_SCOPE=relay