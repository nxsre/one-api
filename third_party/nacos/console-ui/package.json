{
  "name": "console-ui",
  "version": "1.0.0",
  "description": "console ui",
  "main": "src/index.jsx",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && node build/copyFile.js && rm -rf ../console/src/main/resources/static/legacy && cp -r dist ../console/src/main/resources/static/legacy",
    "build:embed": "npx update-browserslist-db@latest --yes && cross-env NACOS_LEGACY_EMBED=1 vite build",
    "preview": "vite preview",
    "eslint": "eslint --ext .js,.jsx src/",
    "eslint-fix": "eslint --ext .js,.jsx --fix src/"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,css,less}": [
      "prettier --write",
      "git add"
    ]
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/nacos.git"
  },
  "devDependencies": {
    "@babel/core": "^7.7.7",
    "@babel/plugin-proposal-decorators": "^7.7.4",
    "@babel/plugin-transform-class-properties": "^7.25.0",
    "@babel/plugin-transform-private-methods": "^7.25.0",
    "@babel/plugin-transform-private-property-in-object": "^7.25.0",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.25.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-eslint": "^10.0.1",
    "babel-plugin-import": "^1.13.0",
    "cross-env": "^6.0.3",
    "eslint": "^6.8.0",
    "eslint-config-ali": "^9.0.2",
    "eslint-config-prettier": "^6.8.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-prettier": "^3.0.0",
    "eslint-plugin-react": "^7.17.0",
    "eslint-plugin-react-hooks": "^2.3.0",
    "husky": "^3.1.0",
    "lint-staged": "^9.5.0",
    "prettier": "1.19.1",
    "sass": "^1.54.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@alifd/next": "^1.26.24",
    "@alifd/theme-design-pro": "0.x",
    "@babel/runtime": "^7.28.2",
    "@iarna/toml": "^3.0.0",
    "axios": "^0.21.1",
    "core-js": "^3.6.4",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "moment": "^2.23.0",
    "prop-types": "^15.6.2",
    "qs": "^6.8.2",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-icons": "^4.12.0",
    "react-redux": "^7.1.3",
    "react-router": "^5.1.2",
    "react-router-dom": "^5.1.2",
    "react-router-redux": "^4.0.8",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "swagger2openapi": "^7.0.8"
  }
}
