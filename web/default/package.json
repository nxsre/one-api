{
  "name": "react-template",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^0.27.2",
    "history": "^5.3.0",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "^8.0.2",
    "jsencrypt": "^3.3.2",
    "marked": "^4.1.1",
    "moment": "^2.30.1",
    "monaco-editor": "^0.55.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "15.5.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.0.8",
    "react-turnstile": "^1.0.5",
    "recharts": "^2.15.1",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-semantic-ui-no-google-fonts.js && node scripts/copy-monaco-vs.js",
    "prebuild": "node ../scripts/generate-web-build-meta.js && node scripts/copy-monaco-vs.js",
    "start": "react-scripts start",
    "build": "react-scripts build && mkdir -p ../build && rm -rf ../build/default && mv -f build ../build/default",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "prettier": "^2.7.1"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true
  },
  "overrides": {
    "fork-ts-checker-webpack-plugin": {
      "ajv": "6.12.6",
      "ajv-keywords": "3.5.2",
      "schema-utils": "2.7.1"
    }
  },
  "proxy": "http://127.0.0.1:3000"
}
