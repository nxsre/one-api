# 开发时 Vite 将 /api 代理到该地址（改 .env 后需重启 npm run dev）
#
# 本机直接跑 one-api：
# VITE_API_PROXY=http://127.0.0.1:3000
#
# docker-compose.yml 映射 13000:3000 时：
# VITE_API_PROXY=http://127.0.0.1:13000
#
# 远程环境（需网络可达，HTTPS 自签证书已允许）：
# VITE_API_PROXY=https://your-host:13443

VITE_API_PROXY=http://127.0.0.1:3000

# 生产构建时 API 根地址（留空则与页面同域）
# VITE_API_BASE=
